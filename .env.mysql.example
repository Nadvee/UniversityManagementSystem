# Copy to .env.mysql.local and fill in your own MySQL credentials.
# Existing native MySQL: MYSQL_USE_DOCKER=false and your current username/password.
MYSQL_USE_DOCKER=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mirpur_advising_db
DB_USERNAME=mirpur_app
DB_PASSWORD=choose-a-database-password
MYSQL_ROOT_PASSWORD=choose-a-different-root-password
MYSQL_APP_PORT=8081
